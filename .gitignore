state/
node_modules/
*.tmp
*.db-wal
*.db-shm

# 连接网关的凭据文件（secret / secretFile），不入库
gateway.json

# LLM 提取配置（含 apiKey），不入库
llm.config.json

# 本机运行日志与一次性补丁/探针（2026-11-25，不入库）
run.log
run.err
*.err
*.log
_patch-*.cjs
scripts/_probe-*.mjs


# dedicated model weights (large binaries)
models/

# 角色音色库配置区（目录即数据库，wav 大二进制不入库）
audios/

# external vision API keys
vision.config.json

# 环境变量载体（可含密钥，模板见 .env.example）
.env

# 子服务运行时输出（stdout/stderr 重定向）
subprocesses/*/run.out
subprocesses/*/run.err
