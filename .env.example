# memory-mcp 环境变量模板：复制为 .env（gitignored，可含密钥）后按需修改。
# 装载时机：memory 进程 start() 入口（真实进程 env > .env > 代码默认值；
# .env 只补缺，不会覆盖已显式设置的环境变量）。装载的键会在启动日志列出。
# 与文件配置的关系：llm.config.json 管 LLM 模型本身，gateway.json 管网关凭据，
# vision.config.json 管外部识图 key——.env 只放运行开关，不放长 JSON 结构。

# ── 存储 / 服务 ───────────────────────────────────────────────
# MEMORY_MCP_STATE_DIR=          # 数据目录（默认 <repo>/state/data；旧名 MEMORY_MCP_DATA_DIR 也认）
                                 # 注意：state/secrets/（http-token）固定在 <repo>/state/secrets，不随此变量搬迁
# MEMORY_MCP_HTTP_PORT=7181      # 回环 HTTP（平台桥接）端口
# MEMORY_MCP_TOKEN=              # HTTP 鉴权 token（缺省自动生成落 state/secrets/http-token，0600）

# ── LLM 覆盖（一般不用：优先改 llm.config.json）────────────────
# MEMORY_MCP_LLM_ENABLED=1
# MEMORY_MCP_LLM_BASE_URL=
# MEMORY_MCP_LLM_API_KEY=
# MEMORY_MCP_LLM_MODEL=
# MEMORY_MCP_LLM_TIMEOUT_MS=30000
# MEMORY_MCP_LLM_VISION_ENABLED=1
# MEMORY_MCP_LLM_VISION_MODEL=
# MEMORY_MCP_LLM_VISION_BASE_URL=
# MEMORY_MCP_LLM_VISION_API_KEY=

# ── 专用模型子服务（model-hub）───────────────────────────────
# MEMORY_MCP_MODEL_HUB_ASR=1               # =0 关本地 ASR 子服务
# MEMORY_MCP_MODEL_HUB_ASR_PORT=18102
# MEMORY_MCP_MODEL_HUB_TTS=1               # =0 关 TTS 子服务
# MEMORY_MCP_MODEL_HUB_TTS_PORT=18103
# MEMORY_MCP_MODEL_HUB_VISION_MODE=llm-fallback   # 阶段二激活切 'vision-svc'（外部识图聚合，端口 18104）
# MEMORY_MCP_MODEL_HUB_VISION_PORT=18104

# ── 记忆行为 ─────────────────────────────────────────────────
# MEMORY_MCP_SESSION_IDLE_MINUTES=60       # 会话空闲切分
# MEMORY_MCP_HEAD_QUIET_MINUTES=30         # head/tail 静默窗
# MEMORY_MCP_EMOTION_FRESH_HOURS=2         # 关系情绪新鲜度
# MEMORY_MCP_RELATION_IDENTITY=            # =1 开全局身份层（默认关）
# MEMORY_MCP_PLATFORMS=qq                  # 已知平台（逗号分隔）
# MEMORY_MCP_PLATFORM_STRICT=              # =1 未知平台直接拒（默认只告警）
# MEMORY_MCP_RAW_RETENTION_DAYS=30         # raw 层保留天数
# MEMORY_MCP_MEDIA_RETENTION=1             # =0 关媒体源文件清退
# MEMORY_MCP_MEDIA_RETENTION_HOURS=6
# MEMORY_MCP_MEDIA_RETENTION_DAYS=30
# MEMORY_MCP_RECALL_CROSS_PLATFORM=        # =1 开跨平台召回（默认关：防串台）
# MEMORY_MCP_RECALL_MAX_ROWS=5
# MEMORY_MCP_RECALL_MAX_CHARS=400
